#! /bin/sh

PANTALLA=$(xrandr | grep " connected" | awk '{print $1}')
xrandr --output $PANTALLA --auto &

# ==========================================
# Configuraci�n del Entorno (bspc)
# ==========================================

bspc monitor $(bspc query -M | head -n 1) -d 1 2 3 4 5 6

# Apariencia
bspc config border_width 0
bspc config window_gap 8
bspc config split_ratio 0.5
bspc config borderless_monocle true
bspc config gapless_monocle true
bspc rule -a Screenkey manage=off

# ==========================================
# Autoarranque de Aplicaciones (Daemons)
# ==========================================

# Gestor de atajos de teclado (Solo iniciar si no existe)
pgrep -x sxhkd >/dev/null || sxhkd &

# Portapapeles y resoluci�n de la M�quina Virtual (KVM)
#pgrep -x spice-vdagent >/dev/null || spice-vdagent &

pgrep -x vmware-user-suid-wrapper >/dev/null || vmware-user-suid-wrapper &

# Compositor visual (Picom) - Solo iniciar si no existe
pgrep -x picom >/dev/null || picom &

# Barra de estado (Aseg�rate de que launch.sh tenga un "killall -q polybar" adentro)
$HOME/.config/polybar/launch.sh &

# ==========================================
# Ajustes r�pidos de una sola ejecuci�n
# ==========================================

# Fondo de pantalla (feh es más liviano que nitrogen en VM)
feh --no-fehbg --bg-fill "$HOME/Pictures/wallpapers/wallhaven-5y5537_1920x1200.png" &

# Compatibilidad para Java (pantallas grises)
wmname LG3D &

# Soluci�n para el cursor (forzar la flecha normal)
xsetroot -cursor_name left_ptr &

# Configuraci�n de teclado
setxkbmap -layout us -variant alt-intl
